{
  "id": "cinehdplus",
  "name": "CineHD Plus",
  "version": "0.1.2",
  "apiVersion": 9,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Películas y series en español latino o castellano de cinehdplus.org: sección propia, géneros, populares, mejor valoradas, búsqueda y varios servidores por título.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-cinehdplus",
  "hosts": [
    "cinehdplus.org",
    "www.cinehdplus.org",
    "api.cinehdplus.org",
    "fotise.com",
    "voe.sx",
    "mixdrop.top",
    "mixdrop.to",
    "mixdrop.co",
    "mixdrop.ag",
    "mixdrop.ch",
    "mixdrop.ps",
    "mixdrop.sx",
    "mixdrop.bz",
    "mxdrop.to",
    "mxdrop.click",
    "streamtape.com",
    "streamtape.to",
    "streamtape.net",
    "streamta.pe",
    "strtape.cloud",
    "strcloud.link",
    "stape.fun",
    "streamadblocker.xyz",
    "vibuxer.com",
    "embedwish.com",
    "hglink.to",
    "hlswish.com",
    "streamwish.com",
    "streamwish.to",
    "strwish.com",
    "wishembed.com",
    "filelions.com",
    "vidhide.com",
    "vidhidepro.com",
    "vidhideplus.com",
    "vidhidefast.com",
    "callistanise.com",
    "dintezuvio.com",
    "minochinos.com",
    "filelions.to",
    "morencius.com",
    "*.premilkyway.com"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download",
    "scopedSearch"
  ],
  "browser": true,
  "streamHosts": "any",
  "telemetry": true,
  "categories": [
    "movies",
    "series"
  ],
  "color": "#F97316",
  "section": {
    "label": "CineHD Plus",
    "labelEn": "CineHD Plus"
  },
  "theme": {
    "accent": "#F97316",
    "onAccent": "#1A0A00",
    "background": "#120A05",
    "surface": "#201208",
    "highlight": "#FDBA74"
  },
  "settings": [
    {
      "key": "audioSection",
      "type": "section",
      "label": "Idioma",
      "labelEn": "Language",
      "hint": "Cada título puede traer varios idiomas; Kino abre primero el que elijas y, si falla, los demás.",
      "hintEn": "A title may come in several languages; Kino opens the one you pick first and, if it fails, the others."
    },
    {
      "key": "audio",
      "type": "select",
      "label": "Idioma preferido",
      "labelEn": "Preferred language",
      "default": "lat",
      "options": [
        {
          "value": "lat",
          "label": "Latino",
          "labelEn": "Latino"
        },
        {
          "value": "cast",
          "label": "Castellano",
          "labelEn": "Castilian"
        },
        {
          "value": "sub",
          "label": "Subtitulado",
          "labelEn": "Subtitled"
        }
      ]
    },
    {
      "key": "info",
      "type": "status",
      "label": "Estado",
      "labelEn": "Status"
    },
    {
      "key": "clearCache",
      "type": "action",
      "label": "Vaciar caché",
      "labelEn": "Clear cache",
      "confirm": "¿Vaciar la caché de listas?",
      "confirmEn": "Clear the list cache?"
    }
  ]
}
